{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "gcc-warnings",
      "hidden": true,
      "cacheVariables": {
        "PRIMERPICKER_WARNING_FLAGS": "-Wall;-Wextra;-Wpedantic;-Wcast-align;-Wcast-qual;-Wconversion;-Wdate-time;-Wdouble-promotion;-Wfloat-equal;-Wformat=2;-Wimplicit-fallthrough;-Wnon-virtual-dtor;-Wnull-dereference;-Wold-style-cast;-Woverloaded-virtual;-Wshadow;-Wsign-conversion;-Wswitch-default;-Wswitch-enum;-Wundef;-Wuninitialized;-Wunused;-Wunused-macros;-Wvla;-Wduplicated-branches;-Wduplicated-cond;-Wformat-overflow;-Wlogical-op;-Wunsafe-loop-optimizations;-Wuseless-cast"
      }
    },
    {
      "name": "clang-warnings",
      "hidden": true,
      "cacheVariables": {
        "PRIMERPICKER_WARNING_FLAGS": "-Wall;-Wextra;-Wpedantic;-Wcast-align;-Wcast-qual;-Wconversion;-Wdate-time;-Wdouble-promotion;-Wfloat-equal;-Wformat=2;-Wimplicit-fallthrough;-Wnon-virtual-dtor;-Wnull-dereference;-Wold-style-cast;-Woverloaded-virtual;-Wshadow;-Wsign-conversion;-Wswitch-default;-Wswitch-enum;-Wundef;-Wuninitialized;-Wunused;-Wunused-macros;-Wvla;-Wassign-enum;-Wcomma;-Wextra-semi;-Wover-aligned"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug, GCC, ASan + UBSan",
      "inherits": [
        "base",
        "gcc-warnings"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -ggdb3",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -D_GLIBCXX_ASSERTIONS",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "displayName": "Release, GCC",
      "inherits": [
        "base",
        "gcc-warnings"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-libstdcxx",
      "displayName": "Debug, clang 20 and libstdc++ (reference library for clang-tidy)",
      "inherits": [
        "base",
        "clang-warnings"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -D_GLIBCXX_ASSERTIONS",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Debug, clang 20 and libc++, ASan + UBSan",
      "inherits": [
        "base",
        "clang-warnings"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_DEBUG",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined",
        "FETCHCONTENT_TRY_FIND_PACKAGE_MODE": "NEVER"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "Release, cross-compiled to Windows with MinGW-w64",
      "inherits": [
        "base",
        "gcc-warnings"
      ],
      "toolchainFile": "${sourceDir}/cmake/mingw-w64-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-libstdcxx",
      "configurePreset": "clang-libstdcxx"
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "clang-debug",
      "inherits": "base",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-libstdcxx",
      "inherits": "base",
      "configurePreset": "clang-libstdcxx"
    },
    {
      "name": "mingw-release",
      "inherits": "base",
      "configurePreset": "mingw-release"
    }
  ]
}
