# clang-tidy checks, chosen to enforce the rules of CLAUDE.md
# (run: clang-tidy-20 -p build/clang-debug FILE)
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-designated-initializers,
  -modernize-use-trailing-return-type,
  -readability-identifier-naming
# CLAUDE.md: avoid identifiers shorter than three letters
CheckOptions:
  readability-identifier-length.MinimumVariableNameLength: 3
  readability-identifier-length.MinimumParameterNameLength: 3
  readability-identifier-length.MinimumLoopCounterNameLength: 3
  readability-implicit-bool-conversion.AllowPointerConditions: false
  # Qt's public headers (QTest, QObject...) provide symbols declared in
  # internal headers (qnamespace.h, qtestkeyboard.h): no mapping exists
  misc-include-cleaner.IgnoreHeaders: 'catch2/.*;.*/Qt[A-Za-z]+/q[a-z0-9_]+\.h'
HeaderFilterRegex: 'src/core/.*'
WarningsAsErrors: ''
